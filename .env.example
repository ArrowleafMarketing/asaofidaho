# Copy to .env.local for local development, and set the same values in your
# host's environment variables (Vercel: Settings -> Environment Variables).
#
# Contact form delivery. Pick ONE of the two paths below.
# With neither set, the form validates but reports that it is not connected --
# it will not silently swallow enquiries.

# ---------------------------------------------------------------------------
# Path 1 (recommended): send email directly via Resend -- https://resend.com
# ---------------------------------------------------------------------------
# The sending DOMAIN has to be verified with Resend. Use asaofidaho.com, which
# the association already owns -- you cannot send *from* a gmail.com address.
# The recipient can be any address, gmail included.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=website@asaofidaho.com

# ---------------------------------------------------------------------------
# Path 2: POST the submission to Zapier / Make / Formspree and let that service
# send the email. No DNS setup, but one more service in the chain.
# ---------------------------------------------------------------------------
# CONTACT_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/000000/xxxxxxx/

# ---------------------------------------------------------------------------
# Optional: override where enquiries land. Defaults to `site.email`
# (asaofidaho@gmail.com) from src/lib/site.ts.
# Point this at a test inbox while you are verifying the setup.
# ---------------------------------------------------------------------------
# CONTACT_TO_EMAIL=asaofidaho@gmail.com
